{
  "import": [
    "Milky2018/moon_cpal/core",
    "Milky2018/moon_cpal/alsa",
    "Milky2018/moon_cpal/jack",
    "Milky2018/moon_cpal/macos",
    "Milky2018/moon_cpal/null",
    "Milky2018/moon_cpal/wasapi"
  ],
  "targets": {
    "platform_native.mbt": ["native"],
    "platform_stub.mbt": ["not", "native"],
    "platform_native_test.mbt": ["native"],
    "platform_stub_test.mbt": ["not", "native"]
  },
  "link": {
    "native": {
      "cc": "./scripts/moon_cc.sh",
      "cc-link-flags": "-pthread -lasound -ljack -framework CoreAudio -framework CoreFoundation -framework AudioToolbox -lole32 -luuid -lmmdevapi -lavrt"
    }
  }
}
