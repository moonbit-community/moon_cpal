import {
  "moonbit-community/moon_cpal/core",
  "moonbit-community/moon_cpal/alsa",
  "moonbit-community/moon_cpal/jack",
  "moonbit-community/moon_cpal/macos",
  "moonbit-community/moon_cpal/null",
  "moonbit-community/moon_cpal/wasapi",
  "moonbitlang/core/debug",
}

supported_targets = "native"

options(
  targets: {
    "platform_native.mbt": [ "native" ],
    "platform_native_test.mbt": [ "native" ],
    "platform_stub.mbt": [ "not", "native" ],
    "platform_stub_test.mbt": [ "not", "native" ],
  },
)
