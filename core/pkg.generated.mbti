} derive(Eq, @debug.Debug)
pub fn U24::U24(Int) -> Self
pub fn U24::equal(Self, Self) -> Bool
pub fn U24::equilibrium() -> Self
pub fn U24::format(Self) -> SampleFormat
pub fn U24::from_f32(Float) -> Self
pub fn U24::from_sample(Float) -> Self
pub fn U24::new(Int) -> Self
pub fn U24::not_equal(Self, Self) -> Bool
pub fn U24::output(Self, &Logger) -> Unit
pub fn U24::to_f32(Self) -> Float
pub fn U24::to_int(Self) -> Int
pub fn U24::to_repr(Self) -> @debug.Repr
pub fn U24::to_string(Self) -> String
pub impl FromSample for U24
pub impl Sample for U24
pub impl SizedSample for U24
pub impl Show for U24

// Type aliases
pub type ChannelCount = Int

pub type FrameCount = Int

pub type SampleRate = Int

// Traits
pub trait FromSample : Sample {
  fn from_sample(Float) -> Self
}
pub impl FromSample for Byte
pub impl FromSample for Int16
pub impl FromSample for UInt16
pub impl FromSample for Float
pub impl FromSample for Double

pub trait Sample {
  fn equilibrium() -> Self
  fn to_f32(Self) -> Float
  fn from_f32(Float) -> Self
}
pub impl Sample for Byte
pub impl Sample for Int16
pub impl Sample for UInt16
pub impl Sample for Float
pub impl Sample for Double

pub trait SizedSample : Sample {
  fn format(Self) -> SampleFormat
}
pub impl SizedSample for Byte
pub impl SizedSample for Int16
pub impl SizedSample for UInt16
pub impl SizedSample for Float
pub impl SizedSample for Double
